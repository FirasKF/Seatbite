# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string — replace with your own
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@your-cluster.xxxxx.mongodb.net/seatbite?retryWrites=true&w=majority

# JWT signing secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# CORS — comma-separated list of allowed browser origins.
# Supports exact origins (https://seatbite.vercel.app) and *. wildcard hostname suffixes (*.vercel.app).
# If unset, defaults to: http://localhost:5173,https://seatbite.vercel.app,*.vercel.app
# Override here (or in your hosting platform's env vars) to lock down or expand without redeploying.
CORS_ORIGINS=