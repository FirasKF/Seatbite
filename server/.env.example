# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string — replace with your own
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@your-cluster.xxxxx.mongodb.net/seatbite?retryWrites=true&w=majority

# JWT signing secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=